{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for purchase.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "number", "description": "Product price" },
        "image": { "type": "string", "description": "Product image URL or base64" },
        "category": { "type": "string", "description": "Product category name" },
        "brand": { "type": "string", "description": "Product brand name" },
        "attributes": { "type": "string", "description": "JSON string of product attributes" },
        "is_featured": { "type": "boolean", "description": "Whether the product is featured" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "customer_name": { "type": "string", "description": "Customer's full name" },
        "email": { "type": "string", "format": "email", "description": "Customer's email" },
        "phone": { "type": "string", "description": "Customer's phone number" },
        "address": { "type": "string", "description": "Shipping address" },
        "product_id": { "type": "string", "description": "ID of the product ordered" },
        "attributes": { "type": "string", "description": "JSON string of selected attributes" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "delivered"], "description": "Order status" },
        "estimated_delivery": { "type": "string", "format": "date-time", "description": "Estimated delivery date" },
        "created_at": { "type": "string", "format": "date-time", "description": "Order timestamp" },
        "shipping_area_id": { "type": "string", "description": "ID of the shipping area" },
        "device_id": { "type": "string", "description": "Unique device ID for fraud prevention" }
      },
      "required": ["customer_name", "phone", "address", "product_id"]
    },
    "Review": {
      "title": "Review",
      "description": "A product review.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string", "description": "ID of the product reviewed" },
        "customer_name": { "type": "string", "description": "Customer's name" },
        "rating": { "type": "number", "description": "Rating from 1 to 5" },
        "comment": { "type": "string", "description": "Review comment" },
        "created_at": { "type": "string", "format": "date-time", "description": "Review timestamp" }
      },
      "required": ["product_id", "customer_name", "rating", "comment"]
    },
    "ShippingArea": {
      "title": "ShippingArea",
      "description": "A shipping area with its cost.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Area name" },
        "cost": { "type": "number", "description": "Shipping cost" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "cost"]
    },
    "Category": {
      "title": "Category",
      "description": "A product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name" },
        "slug": { "type": "string", "description": "Category slug" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "slug"]
    },
    "Brand": {
      "title": "Brand",
      "description": "A product brand.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Brand name" },
        "slug": { "type": "string", "description": "Brand slug" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "slug"]
    },
    "Attribute": {
      "title": "Attribute",
      "description": "A product attribute (e.g., Color).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Attribute name" },
        "slug": { "type": "string", "description": "Attribute slug" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "slug"]
    },
    "AttributeValue": {
      "title": "AttributeValue",
      "description": "A value for a product attribute.",
      "type": "object",
      "properties": {
        "attribute_id": { "type": "string", "description": "ID of the parent attribute" },
        "value": { "type": "string", "description": "Attribute value" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["attribute_id", "value"]
    },
    "ProductVariation": {
      "title": "ProductVariation",
      "description": "A variation of a product (e.g., Red/Large).",
      "type": "object",
      "properties": {
        "product_id": { "type": "string", "description": "ID of the parent product" },
        "attributes": { "type": "string", "description": "JSON string of attributes for this variation" },
        "quantity": { "type": "number", "description": "Stock quantity" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["product_id", "attributes", "quantity"]
    },
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "User's name" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User's role" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "email"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "A product in a user's wishlist.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "ID of the user" },
        "product_id": { "type": "string", "description": "ID of the product" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["user_id", "product_id"]
    },
    "BlockedCustomer": {
      "title": "BlockedCustomer",
      "description": "A blocked customer phone number.",
      "type": "object",
      "properties": {
        "phone_number": { "type": "string", "description": "The blocked phone number" },
        "reason": { "type": "string", "description": "Reason for blocking" },
        "blocked_at": { "type": "string", "format": "date-time", "description": "Timestamp of block" }
      },
      "required": ["phone_number"]
    },
    "BlockedDevice": {
      "title": "BlockedDevice",
      "description": "A blocked device ID.",
      "type": "object",
      "properties": {
        "device_id": { "type": "string", "description": "The blocked device ID" },
        "reason": { "type": "string", "description": "Reason for blocking" },
        "blocked_at": { "type": "string", "format": "date-time", "description": "Timestamp of block" }
      },
      "required": ["device_id"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "A newsletter email subscriber.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber email address" },
        "created_at": { "type": "string", "format": "date-time", "description": "Subscription timestamp" }
      },
      "required": ["email"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "A price drop notification request for a specific product.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "product_id": { "type": "string", "description": "ID of product" },
        "product_name": { "type": "string", "description": "Name of product" },
        "target_price": { "type": "number", "description": "Target or current price threshold" },
        "created_at": { "type": "string", "format": "date-time", "description": "Subscription timestamp" }
      },
      "required": ["email", "product_id"]
    },
    "StockNotification": {
      "title": "StockNotification",
      "description": "An email alert subscription when an out-of-stock item is replenished.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "product_id": { "type": "string", "description": "ID of product" },
        "product_name": { "type": "string", "description": "Name of product" },
        "product_price": { "type": "number", "description": "Price of product" },
        "product_image": { "type": "string", "description": "Image URL of product" },
        "product_category": { "type": "string", "description": "Category of product" },
        "user_id": { "type": "string", "description": "User ID if signed in" },
        "status": { "type": "string", "description": "Notification status (pending, notified)" },
        "created_at": { "type": "string", "format": "date-time", "description": "Subscription timestamp" }
      },
      "required": ["email", "product_id"]
    },
    "UserAddress": {
      "title": "UserAddress",
      "description": "A saved shipping address for a customer.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "User identifier" },
        "full_name": { "type": "string", "description": "Full name for delivery" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "street_address": { "type": "string", "description": "Street address line" },
        "apartment": { "type": "string", "description": "Apt, Suite, Unit (optional)" },
        "city": { "type": "string", "description": "City" },
        "state": { "type": "string", "description": "State or Province" },
        "postal_code": { "type": "string", "description": "ZIP or Postal code" },
        "country": { "type": "string", "description": "Country" },
        "is_default": { "type": "boolean", "description": "Whether this is the default shipping address" },
        "label": { "type": "string", "description": "Address label (Home, Work, Other)" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["full_name", "phone", "street_address", "city", "country"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Customer notification and communication settings.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "User identifier" },
        "email_order_updates": { "type": "boolean", "description": "Receive order status and tracking emails" },
        "email_promotions": { "type": "boolean", "description": "Receive weekly deals and discount coupons" },
        "email_price_alerts": { "type": "boolean", "description": "Receive alerts when saved items drop in price" },
        "email_stock_alerts": { "type": "boolean", "description": "Receive alerts when out-of-stock items restock" },
        "sms_notifications": { "type": "boolean", "description": "Receive SMS shipment alerts" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["email_order_updates"]
    },
    "LiveProductActivity": {
      "title": "LiveProductActivity",
      "description": "Real-time viewer and cart activity counter for products.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string", "description": "Product ID" },
        "in_carts_count": { "type": "number", "description": "Number of active carts holding this item" },
        "active_viewers": { "type": "number", "description": "Number of active viewers currently browsing" },
        "last_purchased_minutes_ago": { "type": "number", "description": "Minutes since last verified purchase" },
        "remaining_inventory": { "type": "number", "description": "Real-time calculated remaining stock" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["product_id"]
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Collection of products" },
    "/orders/{orderId}": { "schema": "Order", "description": "Collection of orders" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Collection of reviews" },
    "/shipping_areas/{areaId}": { "schema": "ShippingArea", "description": "Collection of shipping areas" },
    "/categories/{categoryId}": { "schema": "Category", "description": "Collection of categories" },
    "/brands/{brandId}": { "schema": "Brand", "description": "Collection of brands" },
    "/attributes/{attributeId}": { "schema": "Attribute", "description": "Collection of attributes" },
    "/attribute_values/{valueId}": { "schema": "AttributeValue", "description": "Collection of attribute values" },
    "/product_variations/{variationId}": { "schema": "ProductVariation", "description": "Collection of product variations" },
    "/users/{userId}": { "schema": "User", "description": "Collection of user profiles" },
    "/user_addresses/{addressId}": { "schema": "UserAddress", "description": "Collection of saved customer addresses" },
    "/user_preferences/{prefId}": { "schema": "UserPreferences", "description": "Collection of customer notification preferences" },
    "/live_product_activity/{productId}": { "schema": "LiveProductActivity", "description": "Real-time product viewer and cart counter" },
    "/wishlist/{wishlistId}": { "schema": "Wishlist", "description": "Collection of wishlist items" },
    "/blocked_customers/{blockId}": { "schema": "BlockedCustomer", "description": "Collection of blocked phone numbers" },
    "/blocked_devices/{blockId}": { "schema": "BlockedDevice", "description": "Collection of blocked device IDs" },
    "/newsletter_subscribers/{subscriberId}": { "schema": "NewsletterSubscriber", "description": "Collection of newsletter subscriptions" },
    "/price_alerts/{alertId}": { "schema": "PriceAlert", "description": "Collection of price drop alerts" },
    "/stock_notifications/{notificationId}": { "schema": "StockNotification", "description": "Collection of out-of-stock notification subscriptions" }
  }
}
